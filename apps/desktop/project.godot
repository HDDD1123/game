config_version=5

[application]
config/name="Kingdom Desktop Prototype"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=30

[display]
window/size/viewport_width=960
window/size/viewport_height=620
window/size/window_width_override=960
window/size/window_height_override=620

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.94, 0.93, 0.88, 1)
